import { createHead } from '@vueuse/head';

// The API can be plain HTTP on a different port in local dev (see httpClient.ts's baseURL
// fallback) — connect-src must explicitly allow it, or the browser's CSP silently blocks
// every request as "(blocked:csp)" even though the backend itself is reachable.
const apiBaseUrl = import.meta.env.VITE_API_BASE_URL || 'http://localhost:5080';

export const head = createHead({
  titleTemplate: (title) => (title ? `${title} | <%= it.ProjectName %>` : '<%= it.ProjectName %>'),
  meta: [
    {
      name: 'referrer',
      content: 'no-referrer',
    },
    {
      'http-equiv': 'Content-Security-Policy',
      content: `default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https: ${apiBaseUrl}; base-uri 'self'; form-action 'self'`,
    },
  ],
});

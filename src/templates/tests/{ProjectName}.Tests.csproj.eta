<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\<%= it.ProjectName %>.Api\<%= it.ProjectName %>.Api.csproj" />
    <ProjectReference Include="..\<%= it.ProjectName %>.Application\<%= it.ProjectName %>.Application.csproj" />
    <ProjectReference Include="..\<%= it.ProjectName %>.Domain\<%= it.ProjectName %>.Domain.csproj" />
    <ProjectReference Include="..\<%= it.ProjectName %>.Infrastructure\<%= it.ProjectName %>.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />

using System.Collections.Concurrent;

using <%= it.RootNamespace %>.Api.Helpers;

namespace <%= it.RootNamespace %>.Api.Middlewares;

/// <summary>
/// Screens incoming requests for common attack signatures, oversized bodies and clients that keep
/// sending malicious input, before they reach the rest of the pipeline.
/// </summary>
public sealed class RequestValidationMiddleware(
    RequestDelegate next,
    ILogger<RequestValidationMiddleware> logger,
    RequestPenaltyBox penaltyBox)
{
    private const long MaxRequestBytes = 10 * 1024 * 1024;

    public async Task InvokeAsync(HttpContext context)
    {
        var client = context.Connection.RemoteIpAddress?.ToString() ?? ApiConstants.Unknown;

        if (penaltyBox.IsBlocked(client))
        {
            logger.LogWarning("Blocked request from {IpAddress}", client);
            await Reject(context, StatusCodes.Status403Forbidden, "Access denied");
            return;
        }

        if (SuspiciousRequestDetector.IsSuspicious(context.Request))
        {
            logger.LogWarning("Suspicious request detected from {IpAddress}: {Path}", client, context.Request.Path);
            penaltyBox.Strike(client);
            await Reject(context, StatusCodes.Status400BadRequest, "Invalid request");
            return;
        }

        if (context.Request.ContentLength > MaxRequestBytes)
        {
            logger.LogWarning("Request too large from {IpAddress}: {Size} bytes", client, context.Request.ContentLength);
            await Reject(context, StatusCodes.Status413PayloadTooLarge, "Request too large");
            return;
        }

        await next(context);
    }

    private static Task Reject(HttpContext context, int status, string message)
    {
        context.Response.StatusCode = status;
        return context.Response.WriteAsJsonAsync(new { error = message });
    }
}

/// <summary>
/// Pure check for well-known path traversal, XSS, code/SQL/expression injection fragments in the
/// path, query string and headers of a request.
/// </summary>
public static class SuspiciousRequestDetector
{
    private static readonly string[] Signatures =
    [
        "../", "..\\",
        "<script", "</script>", "javascript:", "onerror=", "onload=",
        "exec(", "eval(",
        "union select", "' or '1'='1", "drop table",
        "${", "#{"
    ];

    public static bool Matches(string? text) =>
        !string.IsNullOrEmpty(text) && Signatures.Any(signature => text.Contains(signature, StringComparison.OrdinalIgnoreCase));

    public static bool IsSuspicious(HttpRequest request) =>
        Matches(request.Path.Value)
        || Matches(request.QueryString.Value)
        || request.Headers.Any(header => Matches(header.Value.ToString()));
}

/// <summary>
/// Remembers clients that keep sending suspicious requests: more than ten strikes inside a minute
/// blocks the client for fifteen minutes.
/// </summary>
public sealed class RequestPenaltyBox(TimeProvider clock)
{
    private const int MaxStrikesPerWindow = 10;
    private static readonly TimeSpan Window = TimeSpan.FromMinutes(1);
    private static readonly TimeSpan BlockDuration = TimeSpan.FromMinutes(15);

    private readonly ConcurrentDictionary<string, Ledger> _ledgers = new();

    public void Strike(string client)
    {
        var now = clock.GetUtcNow();
        var ledger = _ledgers.GetOrAdd(client, _ => new Ledger());

        lock (ledger)
        {
            ledger.Strikes.Enqueue(now);
            while (ledger.Strikes.Count > 0 && now - ledger.Strikes.Peek() > Window)
            {
                ledger.Strikes.Dequeue();
            }

            if (ledger.Strikes.Count > MaxStrikesPerWindow)
            {
                ledger.BlockedUntil = now + BlockDuration;
            }
        }
    }

    public bool IsBlocked(string client)
    {
        if (!_ledgers.TryGetValue(client, out var ledger))
        {
            return false;
        }

        lock (ledger)
        {
            if (ledger.BlockedUntil is { } until && until > clock.GetUtcNow())
            {
                return true;
            }

            ledger.BlockedUntil = null;
            return false;
        }
    }

    private sealed class Ledger
    {
        public Queue<DateTimeOffset> Strikes { get; } = new();
        public DateTimeOffset? BlockedUntil { get; set; }
    }
}

public static class RequestValidationMiddlewareExtensions
{
    public static IApplicationBuilder UseRequestValidation(this IApplicationBuilder builder)
    {
        return builder.UseMiddleware<RequestValidationMiddleware>();
    }
}

using System.Diagnostics;
using System.Security.Claims;

using <%= it.RootNamespace %>.Api.Helpers;
using <%= it.RootNamespace %>.Application.Common;
using <%= it.RootNamespace %>.Application.Interfaces.IRepositories;

namespace <%= it.RootNamespace %>.Api.Middlewares;

/// <summary>
/// Records one audit entry per API call (who, what, from where, and whether it failed) and logs its duration.
/// Supports OWASP #9 - Improper Inventory Management.
/// </summary>
public sealed class AuditLoggingMiddleware(RequestDelegate next, ILogger<AuditLoggingMiddleware> logger)
{
    public async Task InvokeAsync(HttpContext context, IAuditLogRepository auditLog)
    {
        var started = Stopwatch.GetTimestamp();
        string? failure = null;

        try
        {
            await next(context);
        }
        catch (Exception exception)
        {
            failure = exception.Message;
            logger.LogError(exception, "Unhandled exception in request pipeline for {Method} {Path}", context.Request.Method, context.Request.Path);
            throw;
        }
        finally
        {
            await TryRecordAsync(context, auditLog, failure);
            logger.LogInformation(
                "Request {Method} {Path} completed in {Duration}ms with status {StatusCode}",
                context.Request.Method,
                context.Request.Path,
                Stopwatch.GetElapsedTime(started).TotalMilliseconds,
                context.Response.StatusCode);
        }
    }

    public static AuditLogRequest? CreateEntry(HttpContext context, string? failure)
    {
        if (HttpMethods.IsOptions(context.Request.Method))
        {
            return null;
        }

        return new AuditLogRequest
        {
            UserId = context.User.FindFirstValue(ClaimTypes.NameIdentifier),
            UserName = context.User.FindFirstValue(ClaimTypes.Name) ?? "Anonymous",
            Action = context.Request.Method,
            Resource = context.Request.Path.Value ?? string.Empty,
            IpAddress = context.Connection.RemoteIpAddress?.ToString() ?? ApiConstants.Unknown,
            UserAgent = context.Request.Headers.UserAgent.ToString(),
            Success = failure is null,
            ErrorMessage = failure
        };
    }

    private async Task TryRecordAsync(HttpContext context, IAuditLogRepository auditLog, string? failure)
    {
        var entry = CreateEntry(context, failure);
        if (entry is null)
        {
            return;
        }

        try
        {
            await auditLog.LogActionAsync(entry);
        }
        catch (Exception exception)
        {
            // A broken audit store must not hide the real outcome of the request.
            logger.LogWarning(exception, "Failed to write audit entry for {Method} {Path}", entry.Action, entry.Resource);
        }
    }
}

public static class AuditLoggingMiddlewareExtensions
{
    public static IApplicationBuilder UseAuditLogging(this IApplicationBuilder builder)
    {
        return builder.UseMiddleware<AuditLoggingMiddleware>();
    }
}

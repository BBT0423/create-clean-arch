namespace <%= it.RootNamespace %>.Api.Models.Authorize;

/// <summary>
/// The request type for the "/reset-password" endpoint.
/// Requires the "/forgot-password" endpoint to be called first to get the <see cref="Token"/>.
/// </summary>
public class ResetPasswordRequest
{
    /// <summary>
    /// The email address for the user requesting a password reset. Must match <see cref="ForgotPasswordRequest.Email"/>.
    /// </summary>
    public required string Email { get; init; }

    /// <summary>
    /// The code sent to the user's email to reset the password.
    /// </summary>
    public required string Token { get; init; }

    /// <summary>
    /// The new password the user should log in with going forward.
    /// </summary>
    public required string NewPassword { get; init; }
}

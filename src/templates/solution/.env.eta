# Local development secrets — generated by create-clean-arch. Gitignored — never commit real secrets.
# APP_DB_CONNECTION below assumes SQL Server LocalDB; replace it if you target a different server.
APP_DB_CONNECTION=TrustServerCertificate=True
<% if (it.IncludeAuth === "true") { %>APP_JWT_SECRET=<%= it.GeneratedJwtSecret %>
# APP_SMTP_* below are DUMMY placeholders — EnableEmailNotifications is false by default so they're
# unused, but replace them with real SMTP credentials before flipping that setting on.
APP_SMTP_USERNAME=dev@example.com
APP_SMTP_PASSWORD=dev-password
<% } %>
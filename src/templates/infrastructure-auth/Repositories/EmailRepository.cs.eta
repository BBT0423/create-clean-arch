using System.Net.Mail;

using <%= it.RootNamespace %>.Application.Interfaces;
using <%= it.RootNamespace %>.Application.Interfaces.IRepositories;
using <%= it.RootNamespace %>.Infrastructure.Common;

namespace <%= it.RootNamespace %>.Infrastructure.Repositories;

/// <summary>
/// Sends an email right away. If the first attempt fails the message is handed to the outbox, so a
/// slow or unavailable mail server never fails the request that triggered the email.
/// </summary>
public sealed class EmailRepository(MailTransport transport, EmailOutbox outbox, IAppLogger logger) : IEmailRepository
{
    public async Task SendEmailAsync(MailMessage mail, CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(mail);

        var envelope = EmailEnvelope.From(mail);
        if (await transport.TrySendAsync(envelope, cancellationToken))
        {
            return;
        }

        logger.LogDebug("Email to {Recipients} failed on the first attempt; queued for retry.", string.Join(";", envelope.Recipients));
        outbox.Requeue(envelope, attemptsMade: 1);
    }
}

using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;

using <%= it.RootNamespace %>.Infrastructure.DependencyInjection;

namespace <%= it.RootNamespace %>.Infrastructure;

public static class InfrastructureServiceRegistration
{
    /// <summary>
    /// Registers everything the Infrastructure layer provides. Each concern lives in its own
    /// extension under <c>DependencyInjection/</c>.
    /// </summary>
    public static IServiceCollection AddInfrastructureServiceRegistration(
        this IServiceCollection services,
        IConfiguration configuration)
    {
        return services
            .AddApplicationSettings()
            .AddPersistence(configuration)
            .AddJwtAuthentication()
            .AddClientRateLimiting()
            .AddWebClientCors(configuration)
            .AddEmailDelivery();
    }
}
